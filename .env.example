# Copy to .env. Nothing here is required to run the Phase 1 pilot locally —
# the defaults are local-first and need no credentials.

# ── Identity (Section 6, Section 7.4) ────────────────────────────────────────
# Every evidence row names the non-human principal that acted and the human on
# whose authority it acted. Phase 4 replaces these with workload identity.
AGENT_PRINCIPAL=agent://local/pilot
DELEGATED_BY=

# ── Evidence sink ────────────────────────────────────────────────────────────
# jsonl (default) | sqlite | bigquery | memory
EVIDENCE_SINK=jsonl
EVIDENCE_PATH=./evidence/evidence.jsonl
# Records that fail the primary sink land here rather than being lost.
EVIDENCE_SPILL_PATH=./evidence/spill.jsonl
# false in Phase 1: a pilot that dies on a sink hiccup produces no evidence at
# all. Flip to true once the log is control evidence rather than good practice
# (watch item W5).
EVIDENCE_FAIL_CLOSED=false

# ── BigQuery (Section 4.4 — dev dataset in Phase 1, governed in Phase 3) ─────
# Only read when EVIDENCE_SINK=bigquery. Requires the [gcp] extra.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=agent_evidence_dev
BIGQUERY_TABLE=tool_calls

# ── Model (Section 4.2 — always explicit, never the deprecated default) ──────
# fake (no credentials, used by the test suite) | anthropic | vertex
AGENT_MODEL_PROVIDER=fake
AGENT_MODEL_NAME=
# Only for AGENT_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only for AGENT_MODEL_PROVIDER=vertex; requires the [gcp] extra and ADC
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west4

# ── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_KNOWLEDGE_DIR=./data/knowledge
# Comma-separated. Phase 1 is read-only: record_evidence is deliberately absent.
GATEWAY_ALLOWED_TOOLS=lookup_service_context,get_control_requirements,recall

# ── Skills (Section 3.3 — Git is the system of record) ───────────────────────
SKILLS_DIR=./skills

# ── Run limits (Section 4.2) ─────────────────────────────────────────────────
AGENT_RUN_LIMIT=25
